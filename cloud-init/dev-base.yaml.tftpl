#cloud-config
package_update: true
packages: ${jsonencode(packages)}

users:
  - default
  - name: dev
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false

# パスワード欄が"!"(ロック)だとsshdが公開鍵も拒否する。"*"ならパスワードログイン不可のまま鍵は通る
runcmd:
  - [usermod, -p, "*", dev]
