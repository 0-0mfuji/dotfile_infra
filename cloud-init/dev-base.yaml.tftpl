#cloud-config
package_update: true
packages: ${jsonencode(packages)}

users:
  - default
  - name: dev
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false

# パスワード欄が"!"(ロック)だとsshdが公開鍵も拒否する。"*"ならパスワードログイン不可のまま鍵は通る
runcmd:
  - [usermod, -p, "*", dev]
  # Zedは拡張機能をSFTP/SCPで転送する。cloud imageのsshd_configにはSubsystemが無く、失敗する
  - [sh, -c, "grep -q '^Subsystem' /etc/ssh/sshd_config || echo 'Subsystem sftp /usr/lib/openssh/sftp-server' >> /etc/ssh/sshd_config; systemctl reload ssh"]
