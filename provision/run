#!/usr/bin/env bash
# サーバー上で実行する。指定したコンテナ (省略時は稼働中の全 *-dev) にプロビジョニングを流す。
# Usage: provision/run [instance ...]
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

instances=("$@")
if [ "${#instances[@]}" -eq 0 ]; then
  while IFS= read -r n; do [ -n "$n" ] && instances+=("$n"); done < <(incus list status=running -c n -f csv | grep -- '-dev$' || true)
fi
[ "${#instances[@]}" -gt 0 ] || { echo "no running *-dev instances" >&2; exit 1; }

# 任意: ~/.config/dev/provision.env (サーバー上・Git管理外)
#   MOBILE_HOST=dev-server.<tailnet>.ts.net
#   MOBILE_MAP="os-dev:8013 lang-dev:8011 cpu-dev:8012"   # コンテナ:ポート (tofuの web_port と同じ値)
# shellcheck disable=SC1091
[ -f "$HOME/.config/dev/provision.env" ] && source "$HOME/.config/dev/provision.env"

mobile_port() {  # $1=instance -> ポート (無ければ空)
  local e; for e in ${MOBILE_MAP:-}; do [ "${e%%:*}" = "$1" ] && { echo "${e#*:}"; return; }; done
}

for i in "${instances[@]}"; do
  echo "==> $i"
  mp="$(mobile_port "$i")"
  incus exec "$i" -- rm -rf /tmp/provision
  incus file push -r "$DIR" "$i/tmp/"
  incus exec "$i" --user 1000 --group 1000 --cwd /home/dev --env HOME=/home/dev --env USER=dev --env "MOBILE_HOST=${MOBILE_HOST:-}" --env "MOBILE_PORT=${mp:-}" -- bash /tmp/provision/agents.sh
done
