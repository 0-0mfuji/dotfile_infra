# プロビジョニングで固定するバージョン。更新するときはここだけ変える。

# Node.js: DeepSeek Harnessの要件は ^22.19 || >=24
NODE_MAJOR=22

# DeepSeek Harness (shiguredo版: 本家master + 日本語UI)。開発者プレビューで互換性が壊れるため、コミットを固定する。
DSH_REPO=https://github.com/shiguredo/deepseek-harness.git
DSH_BRANCH=shiguredo
DSH_COMMIT=d3627f4ff6c52b1cdb325325220c240f9665f62d

# Jujutsu (jj)。SHA-256はGitHubのリリースが公開しているdigest。
JJ_VERSION=0.46.0
JJ_SHA256=fce0271158e665ceb82dc66c5eb95b1728649094e9133074f3b5baece345fc08

# OCaml (lang-dev だけに入る。opam で導入)。コンパイラの版だけ固定し、dune などのライブラリは入れた時点の最新。
OCAML_VERSION=5.3.0

# mdBook (lang-dev だけに入る。静的バイナリ)。SHA-256はGitHubのリリースが公開しているdigest。
MDBOOK_VERSION=0.5.4
MDBOOK_SHA256=5222beabd3e37dc5be0d18ff99b79058469354db5c220153a1b92db5ba12be89

# Rust (lang-dev だけに入る。rustup で導入)。ツールチェーンの版だけ固定する。
RUST_VERSION=1.99.0

# uv (video-dev / blender-dev に入る。Pythonの版とライブラリは、プロジェクトの pyproject.toml / uv.lock で固定する)。
UV_VERSION=0.13.1
UV_SHA256=eadd9d27c134ab5ac1ffd4473b97a741407f3ea238288f03121fc4deddf90220

# VOICEVOX ENGINE (voice-dev だけに入る。CPU版。GPUのVRAMを、他のコンテナに残すため)。SHA-256はGitHubのリリースが公開しているdigest。
VOICEVOX_VERSION=0.25.2
VOICEVOX_SHA256=bab016a966131b89bad398e7b898f8c742617dc80a7da49bf494cd07133dbc7a

# Blender (blender-dev だけに入る。公式のビルド済みtarball)。SHA-256は download.blender.org の blender-<版>.sha256。
BLENDER_VERSION=5.2.2
BLENDER_SHA256=84098912789dc450e95697c4184fb8a90acbe5111c2ba4aede3fecb57806a168

# Turso CLI (web-dev だけに入る。`turso dev` のローカルDB用)。SHA-256はGitHubのリリースが公開しているdigest (turso-cli_Linux_x86_64.tar.gz)。
TURSO_VERSION=1.0.34
TURSO_SHA256=9eb67f3efece578a6407d1fa535a75e8d7b5cde4f6af3ac1dd79929e99768dc9

# web-dev の Python。システムの3.13ではなく、uv で固定する (igakutteru の CI と pyproject は 3.12)
WEB_PYTHON_VERSION=3.12
