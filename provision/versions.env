# プロビジョニングで固定するバージョン。更新するときはここだけ変える。

# Node.js: DeepSeek Harnessの要件は ^22.19 || >=24
NODE_MAJOR=22

# DeepSeek Harness (shiguredo版: 本家master + 日本語UI)。開発者プレビューで互換性が壊れるため、コミットを固定する。
DSH_REPO=https://github.com/shiguredo/deepseek-harness.git
DSH_BRANCH=shiguredo
DSH_COMMIT=d418231c9bec1a3b8675afae66aa927574c28c7c

# Jujutsu (jj)。SHA-256はGitHubのリリースが公開しているdigest。
JJ_VERSION=0.46.0
JJ_SHA256=fce0271158e665ceb82dc66c5eb95b1728649094e9133074f3b5baece345fc08

# OCaml (lang-dev だけに入る。opam で導入)。コンパイラの版だけ固定し、dune などのライブラリは入れた時点の最新。
OCAML_VERSION=5.3.0

# mdBook (lang-dev だけに入る。静的バイナリ)。SHA-256はGitHubのリリースが公開しているdigest。
MDBOOK_VERSION=0.5.4
MDBOOK_SHA256=5222beabd3e37dc5be0d18ff99b79058469354db5c220153a1b92db5ba12be89

# Rust (lang-dev だけに入る。rustup で導入)。ツールチェーンの版だけ固定する。
RUST_VERSION=1.99.0
