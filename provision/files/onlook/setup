#!/usr/bin/env bash
set -euo pipefail

revision=423e2e924366419e418ee049093872d535eea41a
repo=/home/dev/src/onlook
tools=/home/dev/.local/onlook

if ! command -v docker >/dev/null; then
  apt-get update
  apt-get install -y docker.io
fi
systemctl enable --now docker
if ! docker network inspect onlook-local >/dev/null 2>&1; then
  docker network create -o com.docker.network.bridge.host_binding_ipv4=127.0.0.1 onlook-local >/dev/null
fi

run_dev() {
  runuser -u dev -- env HOME=/home/dev PATH="$tools/node_modules/.bin:/usr/local/bin:/usr/bin:/bin" "$@"
}
run_dev mkdir -p "$tools" /home/dev/src
run_dev npm install --prefix "$tools" --no-audit --no-fund bun@1.3.1
if [ ! -d "$repo/.git" ]; then
  run_dev git init "$repo"
  run_dev git -C "$repo" remote add origin https://github.com/onlook-dev/onlook.git
fi
if [ "$(run_dev git -C "$repo" rev-parse --verify HEAD 2>/dev/null || true)" != "$revision" ]; then
  run_dev git -C "$repo" fetch --depth 1 origin "$revision"
  run_dev git -C "$repo" switch --detach FETCH_HEAD
fi

cd "$repo"
run_dev bun install --frozen-lockfile
if [ ! -x node_modules/.bin/supabase ]; then
  run_dev node node_modules/supabase/scripts/postinstall.js
fi
run_dev bun --filter @onlook/web-preload build

install -o dev -g dev -m 755 /dev/stdin "$tools/start-backend" <<'BACKEND'
#!/usr/bin/env bash
set -euo pipefail
cd /home/dev/src/onlook/apps/backend
# OAuth credentials are unnecessary for the upstream development login.
export GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID:-local-dev} GITHUB_SECRET=${GITHUB_SECRET:-local-dev}
export GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-local-dev} GOOGLE_SECRET=${GOOGLE_SECRET:-local-dev}
umask 077
status="$(mktemp)"
trap 'rm -f "$status"' EXIT
if ! bun run --silent status >"$status" 2>/dev/null; then
  if ! ../../node_modules/.bin/supabase start --network-id onlook-local >"$status" 2>&1; then
    sed -E '/(key|postgresql:|secret|token|password)/Id' "$status" >&2
    exit 1
  fi
  bun run --silent status >"$status"
fi
node --input-type=module - "$status" <<'JS'
import { readFileSync, writeFileSync } from "node:fs"
const status = JSON.parse(readFileSync(process.argv[2], "utf8"))
const client = {
  NEXT_PUBLIC_SITE_URL: "http://localhost:3000",
  NEXT_PUBLIC_SUPABASE_URL: "http://localhost:54321",
  NEXT_PUBLIC_SUPABASE_ANON_KEY: status.ANON_KEY,
  SUPABASE_DATABASE_URL: status.DB_URL,
  SUPABASE_SERVICE_ROLE_KEY: status.SERVICE_ROLE_KEY,
}
if (Object.values(client).some((value) => !value)) throw new Error("Incomplete Supabase status")
writeFileSync("../web/client/.env.local", Object.entries(client).map(([key, value]) => `${key}=${value}\n`).join(""))
JS
cd ../../packages/db
if [ ! -f /home/dev/.local/onlook/db-initialized ]; then
  export SUPABASE_URL=http://localhost:54321
  export SUPABASE_DATABASE_URL="$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1])).DB_URL' "$status")"
  export SUPABASE_SERVICE_ROLE_KEY="$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1])).SERVICE_ROLE_KEY' "$status")"
  bun run db:seed
  touch /home/dev/.local/onlook/db-initialized
fi
BACKEND

# Provider credentials are stored in a private runtime file read by Next.js.
credentials="$repo/apps/web/client/.env"
if [ ! -e "$credentials" ]; then
  install -o dev -g dev -m 600 /dev/stdin "$credentials" <<'KEYS'
# Add real values here for project import and AI. Leave blank to use the editor login only.
CSB_API_KEY=
OPENROUTER_API_KEY=
KEYS
fi
install -m 644 "$1" /etc/systemd/system/onlook.service
systemctl daemon-reload
systemctl enable onlook.service
systemctl restart --no-block onlook.service
