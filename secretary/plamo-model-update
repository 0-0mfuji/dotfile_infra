#!/usr/bin/env bash
# Host-side entry point: run the pulled model updater inside secretary-dev.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo 'Run with sudo.' >&2; exit 1; }
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$DIR/versions.env"
instance="${1:-secretary-dev}"
[[ "$instance" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]] || exit 2
remote_work=''
cleanup() {
  if [ -n "$remote_work" ]; then incus exec "$instance" -- rm -rf -- "$remote_work"; fi
}
trap cleanup EXIT
remote_work="$(incus exec "$instance" -- mktemp -d /tmp/secretary-plamo-update.XXXXXXXX)"
incus file push "$DIR/files/plamo-model-update-container" "$instance$remote_work/update.sh"
incus exec "$instance" -- chmod 700 "$remote_work/update.sh"
incus exec "$instance" -- bash "$remote_work/update.sh" "$PLAMO_MODEL" "$PLAMO_REVISION"
