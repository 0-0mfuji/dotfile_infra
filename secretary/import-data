#!/usr/bin/env bash
# Run on the server after Mac rsync. No deletion or source-code transfer.
set -euo pipefail
source_dir="${1:?usage: secretary/import-data <private-staging-directory>}"
[ "$#" -eq 1 ] || exit 2
[ -f "$source_dir/manifest.json" ] && [ -f "$source_dir/files.nul" ] && [ -d "$source_dir/data" ] || {
  echo 'Expected manifest.json, files.nul, data/'; exit 1;
}
# GNU tar --null lists exact manifest paths; no unrelated staging files are sent.
# Prefix the list with data/ without interpreting newlines or shell characters.
list="$(mktemp)"
trap 'rm -f "$list"' EXIT
python3 - "$source_dir/files.nul" "$list" <<'PY'
import pathlib,sys
names=pathlib.Path(sys.argv[1]).read_bytes().split(b'\0')
pathlib.Path(sys.argv[2]).write_bytes(b'manifest.json\0'+b''.join(b'data/'+p+b'\0' for p in names if p))
PY
tar -C "$source_dir" --null -T "$list" -cf - | incus exec secretary-dev -- python3 /opt/secretary/import-tool-data.py
