#!/usr/bin/env bash
# Run on the development host after pulling this repository.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
commit=e96f405baa4823a28a064b039170225454e942d1
instance=secretary-dev
work="$(mktemp -d)"
stage="$(incus exec "$instance" -- mktemp -d /tmp/secretary-twitter.XXXXXXXX)"
trap 'rm -rf "$work"; incus exec "$instance" -- rm -rf "$stage"' EXIT
git clone -q --no-checkout git@github.com:0-0mfuji/TwitterBookmark_to_karakeep.git "$work/upstream"
git -C "$work/upstream" archive "$commit" common.py register_tweets.py upload_media.py | tar -x -C "$work"
for file in common.py register_tweets.py upload_media.py; do
  incus file push "$work/$file" "$instance$stage/$file"
done
for file in twitter-import.py secretary-twitter-import.service; do
  incus file push "$DIR/files/$file" "$instance$stage/$file"
done
incus file push "$DIR/twitter-install" "$instance$stage/twitter-install"
incus exec "$instance" -- bash "$stage/twitter-install" "$@"
if [ "$#" -eq 0 ]; then
  install -d -m 700 "$HOME/.config/systemd/user"
  install -m 644 "$DIR/files/twitter-inhibit.service" "$DIR/files/twitter-inhibit.timer" "$HOME/.config/systemd/user/"
  systemctl --user daemon-reload
  systemctl --user enable --now twitter-inhibit.timer
  systemctl --user start twitter-inhibit.service
fi
