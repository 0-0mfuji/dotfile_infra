[Unit]
Description=Secretary SilverBullet documents
After=network-online.target
[Service]
User=secretary-notes
Group=secretary-documents
WorkingDirectory=/srv/secretary/documents
EnvironmentFile=/etc/secretary-notes.env
Environment=SB_RUNTIME_API=0
Environment=SB_SHELL_BACKEND=off
Environment=HOME=/var/lib/secretary-notes
ExecStart=/usr/local/bin/silverbullet --single -L 127.0.0.1 -p 3000 /srv/secretary/documents
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/secretary/documents /var/lib/secretary-notes
PrivateTmp=true
[Install]
WantedBy=multi-user.target
