[Unit]
Description=Secretary DeepSeek Harness (127.0.0.1:3080)
After=network-online.target
Wants=network-online.target

[Service]
User=secretary
Group=secretary-documents
SupplementaryGroups=secretary
WorkingDirectory=/srv/secretary/documents
Environment=HOME=/home/secretary
Environment=PATH=/usr/local/lib/dev-dsh/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/secretary-dsh web --no-open
StandardOutput=file:/home/secretary/.dsh/web.log
StandardError=inherit
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
