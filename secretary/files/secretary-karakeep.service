[Unit]
Description=Karakeep scoped gateway for the private secretary
After=network-online.target
Wants=network-online.target

[Service]
User=secretary-karakeep
Group=secretary-karakeep
ExecStart=/usr/bin/python3 /opt/secretary/karakeep-gateway.py serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/secretary-karakeep
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
