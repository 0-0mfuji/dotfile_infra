[Unit]
Description=Secretary Hermes messaging and scheduled jobs (optional)
After=network-online.target
Wants=network-online.target
[Service]
User=secretary
Group=secretary
SupplementaryGroups=secretary-documents
WorkingDirectory=/srv/secretary/documents
Environment=HOME=/home/secretary
Environment=HERMES_HOME=/home/secretary/.hermes
Environment=PATH=/home/secretary/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Tokyo
ExecStart=/home/secretary/.local/bin/hermes gateway run
Restart=on-failure
RestartSec=15
UMask=0007
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
[Install]
WantedBy=multi-user.target
