[Unit]
Description=Resume medical OCR then PLaMo bilingual study material
After=network-online.target secretary-karakeep.service
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=simple
User=secretary
Group=secretary-pipeline
UMask=0027
WorkingDirectory=/srv/secretary/karakeep-tool
Environment=HOME=/home/secretary HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/secretary-tools/bin/python /opt/secretary/secretary-pipeline.py gpu
Restart=on-failure
RestartSec=300
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secretary-pipeline /srv/secretary/karakeep-tool/data /home/secretary/.config/secretary/tool-jobs /var/lib/secretary-models/cache /var/lib/secretary-models/numba
PrivateTmp=true
[Install]
WantedBy=multi-user.target
