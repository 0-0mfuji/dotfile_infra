[Unit]
Description=Resume Modal half of bilingual Karakeep article translation
After=network-online.target secretary-karakeep.service
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=simple
User=secretary
Group=secretary-pipeline
UMask=0027
WorkingDirectory=/srv/secretary/karakeep-tool
Environment=HOME=/home/secretary PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/secretary-tools/bin/python /opt/secretary/secretary-pipeline.py modal
Restart=on-failure
RestartSec=300
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secretary-pipeline /srv/secretary/karakeep-tool/data /home/secretary/.config/secretary/tool-jobs
PrivateTmp=true
[Install]
WantedBy=multi-user.target
