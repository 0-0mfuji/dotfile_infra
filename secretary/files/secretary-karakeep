#!/usr/bin/env bash
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo '管理者用です。dev secretary setup karakeep / approve を使ってください' >&2; exit 1; }
/usr/bin/python3 /opt/secretary/karakeep-gateway.py "$@"
if [ "${1:-}" = setup ]; then
  chgrp secretary-karakeep /etc/secretary-karakeep.json
  chmod 640 /etc/secretary-karakeep.json
  systemctl restart secretary-karakeep.service
  systemctl try-restart secretary-nanomuse.service dsh-web.service
fi
