[Unit]
Description=Read-only TimeTree snapshot collector (unofficial API)
After=network-online.target
[Service]
Type=oneshot
User=secretary-timetree
Group=secretary
Environment=HOME=/var/lib/secretary-timetree
ExecStart=/usr/bin/python3 /opt/secretary/secretary.py timetree-sync
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secretary-timetree
PrivateTmp=true
