[Unit]
Description=Resume fixed Narou personal EPUB acquisition
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=simple
User=secretary
Group=secretary-pipeline
UMask=0027
WorkingDirectory=/srv/secretary/karakeep-tool
Environment=HOME=/home/secretary PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/secretary-tools/bin/python /opt/secretary/secretary-pipeline.py narou
Restart=on-failure
RestartSec=600
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secretary-pipeline /srv/secretary/karakeep-tool/data
PrivateTmp=true
[Install]
WantedBy=multi-user.target
