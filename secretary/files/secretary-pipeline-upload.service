[Unit]
Description=Publish completed bilingual articles with inherited Karakeep metadata
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=secretary-karakeep
Group=secretary-karakeep
SupplementaryGroups=secretary-pipeline
UMask=0077
ExecStart=/usr/bin/python3 /opt/secretary/secretary-pipeline-upload.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secretary-karakeep/translations
PrivateTmp=true
