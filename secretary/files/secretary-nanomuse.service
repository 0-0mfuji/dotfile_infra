[Unit]
Description=NanoMuse private secretary
After=network-online.target
Wants=network-online.target
[Service]
User=secretary
Group=secretary-documents
SupplementaryGroups=secretary
WorkingDirectory=/srv/secretary/documents
Environment=HOME=/home/secretary TZ=Asia/Tokyo NANOMUSE_NO_UPDATE_CHECK=1
Environment=PATH=/opt/nanomuse/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/nanomuse/current/.venv/bin/nanomuse serve --config /home/secretary/.nanomuse/config.toml --no-qr
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/secretary/.nanomuse /home/secretary/.config/secretary /srv/secretary/documents
PrivateTmp=true
# 公式起動バナーが認証トークンを含むため、stdoutをjournalへ保存しない。
StandardOutput=null
StandardError=journal
[Install]
WantedBy=multi-user.target
