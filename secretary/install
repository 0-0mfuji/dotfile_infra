#!/usr/bin/env bash
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo 'コンテナ内でrootとして実行してください' >&2; exit 1; }
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=versions.env
source "$DIR/versions.env"
[ "$#" -eq 0 ] || { echo "usage: secretary/install" >&2; exit 2; }
apt-get update
apt-get install -y curl ca-certificates git unzip python3 python3-yaml age
id secretary >/dev/null 2>&1 || useradd --create-home --shell /bin/bash secretary
id secretary-notes >/dev/null 2>&1 || useradd --system --home-dir /var/lib/secretary-notes --create-home --shell /usr/sbin/nologin secretary-notes
id secretary-timetree >/dev/null 2>&1 || useradd --system --home-dir /var/lib/secretary-timetree --create-home --shell /usr/sbin/nologin secretary-timetree
getent group secretary-documents >/dev/null || groupadd --system secretary-documents
usermod -aG secretary-documents secretary
usermod -aG secretary-documents secretary-notes
install -d -m 2770 -o secretary -g secretary-documents /srv/secretary/documents
install -d -m 750 -o secretary-timetree -g secretary /var/lib/secretary-timetree
install -d -m 750 -o secretary-timetree -g secretary /var/lib/secretary-timetree/cache
# SilverBullet自身の認証ストアは専用ユーザーだけが読み書きする。
if [ -f /srv/secretary/documents/.silverbullet.auth.json ] && [ ! -L /srv/secretary/documents/.silverbullet.auth.json ]; then
  chown secretary-notes:secretary-documents /srv/secretary/documents/.silverbullet.auth.json
  chmod 600 /srv/secretary/documents/.silverbullet.auth.json
fi
install -d -m 700 -o secretary -g secretary /home/secretary/.config/secretary
install -d -m 755 /opt/secretary
install -m 644 "$DIR/files/secretary.py" /opt/secretary/
install -m 755 "$DIR/files/secretary" /usr/local/bin/secretary
install -m 755 "$DIR/backup" /opt/secretary/backup
install -m 644 "$DIR/versions.env" /opt/secretary/versions.env
# 新規文書のみ配置し、ユーザーの編集を再導入で上書きしない。
for folder in inbox daily hobbies plans mail attachments; do
  install -d -m 2770 -o secretary -g secretary-documents "/srv/secretary/documents/$folder"
done
for doc in "$DIR/documents/"*.md; do
  target="/srv/secretary/documents/$(basename "$doc")"
  if [ ! -e "$target" ] || { [ ! -L "$target" ] && grep -qFx "$(sha256sum "$target" | cut -d ' ' -f 1)  ${doc##*/}" "$DIR/documents/previous-sha256"; }; then
    install -m 660 -o secretary -g secretary-documents "$doc" "$target"
  fi
done
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
case "$(uname -m)" in
  x86_64) arch=x86_64; digest="$SILVERBULLET_X86_64_SHA256" ;;
  aarch64) arch=aarch64; digest="$SILVERBULLET_AARCH64_SHA256" ;;
  *) echo '対応CPU: x86_64 / aarch64' >&2; exit 1 ;;
esac
if [ ! -x /usr/local/bin/silverbullet ] || [ "$(cat /opt/secretary/silverbullet.version 2>/dev/null || true)" != "$SILVERBULLET_VERSION" ]; then
  curl -fsSL "https://github.com/silverbulletmd/silverbullet/releases/download/$SILVERBULLET_VERSION/silverbullet-server-linux-$arch.zip" -o "$work/sb.zip"
  echo "$digest  $work/sb.zip" | sha256sum -c -
  unzip -q "$work/sb.zip" -d "$work/sb"
  install -m 755 "$work/sb/silverbullet" /usr/local/bin/silverbullet
  echo "$SILVERBULLET_VERSION" > /opt/secretary/silverbullet.version
fi
for unit in secretary-nanomuse.service secretary-notes.service secretary-timetree.service secretary-timetree.timer; do
  install -m 644 "$DIR/files/$unit" /etc/systemd/system/
done
# devは管理用。AIが動くsecretaryユーザーにはsudo権限を付けない。
cat > /etc/sudoers.d/secretary-operator <<'SUDO'
dev ALL=(secretary) NOPASSWD: /usr/local/bin/secretary *
SUDO
chmod 440 /etc/sudoers.d/secretary-operator
systemctl daemon-reload
bash "$DIR/retire-hermes"
bash "$DIR/nanomuse-install"
# SilverBulletはログイン設定後にのみ起動する。
if [ -s /etc/secretary-notes.env ]; then systemctl enable secretary-notes; systemctl restart secretary-notes; fi
echo '導入完了。Macで dev secretary を実行してください。'
