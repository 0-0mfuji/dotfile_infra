#!/usr/bin/env bash
# Run on the development host after pulling this repository.
set -euo pipefail
[ "$#" -eq 1 ] || { echo 'usage: secretary/study-resume {plan|prepare|start|status|dispatch}' >&2; exit 2; }
case "$1" in
  plan|prepare)
    exec systemd-inhibit --what=sleep --mode=block --why='Verify and migrate secretary study library' \
      incus exec secretary-dev -- runuser -u secretary -- \
      /opt/secretary-tools/bin/python /opt/secretary/study-resume.py "$1"
    ;;
  start)
    # Keep the user manager alive when the last SSH session closes.
    if [ "$(loginctl show-user "$(id -un)" -p Linger --value)" != yes ]; then
      loginctl enable-linger "$(id -un)"
    fi
    exec systemd-run --user --unit=secretary-study-resume --collect \
      systemd-inhibit --what=sleep --mode=block --why='Secretary study EPUB conversion' \
      incus exec secretary-dev -- runuser -u secretary -- \
      /opt/secretary-tools/bin/python /opt/secretary/study-resume.py run
    ;;
  status)
    systemctl --user status secretary-study-resume --no-pager || true
    exec incus exec secretary-dev -- runuser -u secretary -- \
      /opt/secretary-tools/bin/python /opt/secretary/study-resume.py status
    ;;
  dispatch)
    action="$(incus exec secretary-dev -- runuser -u secretary -- /usr/bin/python3 /opt/secretary/study-control.py claim)"
    [ "$action" = start ] || exit 0
    if systemctl --user is-active --quiet secretary-study-resume || "$0" start; then
      incus exec secretary-dev -- runuser -u secretary -- /usr/bin/python3 /opt/secretary/study-control.py started
    else
      incus exec secretary-dev -- runuser -u secretary -- /usr/bin/python3 /opt/secretary/study-control.py failed
      exit 1
    fi
    ;;
  *) echo 'usage: secretary/study-resume {plan|prepare|start|status|dispatch}' >&2; exit 2 ;;
esac
