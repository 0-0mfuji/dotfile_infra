#!/usr/bin/env bash
# Inside secretary-dev, after files arrive from the pulled infrastructure checkout.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exit 1
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
install -m 644 "$DIR/versions.env" /opt/secretary/pipeline-versions.env
getent group secretary-pipeline >/dev/null || groupadd --system secretary-pipeline
install -d -m 2750 -o secretary -g secretary-pipeline /var/lib/secretary-pipeline
for folder in outbox sentences epubs; do
  install -d -m 2750 -o secretary -g secretary-pipeline "/var/lib/secretary-pipeline/$folder"
done
install -d -m 700 -o secretary-karakeep -g secretary-karakeep /var/lib/secretary-karakeep/translations
for file in secretary-pipeline.py secretary-pipeline-upload.py plamo-translate.py modal-plamo-app.py modal-plamo-client.py secretary-tools.py; do
  install -m 644 "$DIR/files/$file" "/opt/secretary/$file"
done
if ! /opt/secretary-modal/bin/python -c 'import modal; assert modal.__version__ == "1.2.6"' 2>/dev/null; then
  python3 -m venv /opt/secretary-modal
  /opt/secretary-modal/bin/pip install 'modal==1.2.6'
fi
for unit in secretary-pipeline-gpu.service secretary-pipeline-modal.service secretary-pipeline-narou.service secretary-pipeline-upload.service secretary-pipeline-upload.timer; do
  install -m 644 "$DIR/files/$unit" /etc/systemd/system/
done
install -d -m 755 /etc/tmpfiles.d
install -m 644 "$DIR/files/secretary-pipeline.conf" /etc/tmpfiles.d/
systemd-tmpfiles --create /etc/tmpfiles.d/secretary-pipeline.conf
systemctl daemon-reload
systemctl disable --now secretary-pipeline-upload.timer secretary-pipeline-gpu.service secretary-pipeline-modal.service
systemctl stop secretary-pipeline-upload.service
python3 - "$DIR/skills/karakeep-twitter-import/SKILL.md" <<'PY'
import hashlib, json, os, pathlib, pwd, sys
source = pathlib.Path(sys.argv[1]).read_text()
account = pwd.getpwnam('secretary')
for root, text in ((pathlib.Path('/home/secretary/.nanomuse/skills'), source),
                   (pathlib.Path('/home/secretary/.dsh/skills'), source.replace('secretary_tools__', 'mcp__secretary_tools__'))):
    target = root / 'karakeep-twitter-import' / 'SKILL.md'
    is_dsh = root.parent.name == '.dsh'
    stamp = root / '.secretary-managed.json' if is_dsh else pathlib.Path('/opt/secretary/skills-manifest.json')
    manifest = json.loads(stamp.read_text()) if stamp.exists() else {}
    if target.exists() and target.read_text() != text:
        previous = manifest.get('karakeep-twitter-import')
        if not is_dsh and previous is None:
            previous = 'ef6a684c0594785c0f149c8ec0365ca1866ea03918b7e856d7fc2bfe378b51a0'
        if hashlib.sha256(target.read_bytes()).hexdigest() != previous:
            raise SystemExit('Existing customized skill preserved: ' + str(target))
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    target.write_text(text)
    os.chmod(target.parent, 0o700); os.chmod(target, 0o600)
    os.chown(target.parent, account.pw_uid, account.pw_gid); os.chown(target, account.pw_uid, account.pw_gid)
    manifest['karakeep-twitter-import'] = hashlib.sha256(text.encode()).hexdigest()
    stamp.write_text(json.dumps(manifest, indent=2))
    if is_dsh:
        os.chmod(stamp, 0o600)
        os.chown(stamp, account.pw_uid, account.pw_gid)
PY
systemctl enable secretary-pipeline-narou.service
for unit in secretary-pipeline-narou.service; do
  if [ "$(systemctl show -p SubState --value "$unit")" = auto-restart ]; then
    systemctl restart "$unit"
  else
    systemctl start "$unit"
  fi
done
