#!/usr/bin/env bash
# Root-only companion installation; secretary receives no sudo rights.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exit 1
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARED="$DIR/../provision"
source "$SHARED/versions.env"
apt-get install -y bubblewrap xz-utils python3-yaml
[ "$(uname -m)" = x86_64 ] || { echo 'DSH currently supports x86_64 only'; exit 1; }
if ! /usr/local/bin/node -e 'let [a,b]=process.versions.node.split(".").map(Number);process.exit(a>=24||a===22&&b>=19?0:1)' 2>/dev/null; then
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  base="https://nodejs.org/dist/latest-v${NODE_MAJOR}.x"
  curl -fsSL "$base/SHASUMS256.txt" -o "$work/SHASUMS256.txt"
  archive="$(awk '/node-v[0-9.]+-linux-x64.tar.xz$/ {print $2}' "$work/SHASUMS256.txt")"
  [ -n "$archive" ] || exit 1
  curl -fsSL "$base/$archive" -o "$work/$archive"
  (cd "$work" && grep " $archive\$" SHASUMS256.txt | sha256sum -c -)
  tar -xJf "$work/$archive" -C /usr/local --strip-components=1 --no-same-owner
fi
# Match the other containers: install once, preserve an existing CLI version.
if [ ! -x /usr/local/bin/codex ]; then
  /usr/local/bin/npm install --global @openai/codex@latest
fi
install -d -m 700 -o secretary -g secretary /home/secretary/.codex /home/secretary/.agents /home/secretary/.agents/skills
install -m 755 "$DIR/files/secretary-codex" /usr/local/bin/secretary-codex
[ -e /home/secretary/.codex/AGENTS.md ] || install -m 600 -o secretary -g secretary "$SHARED/files/AGENTS.md" /home/secretary/.codex/AGENTS.md
/usr/local/bin/corepack enable
install -d -m 700 -o secretary -g secretary /home/secretary/src /home/secretary/.dsh /home/secretary/.dsh/skills
source_dir=/home/secretary/src/deepseek-harness
as_secretary() { runuser -u secretary -- env HOME=/home/secretary PATH=/usr/local/bin:/usr/bin:/bin "$@"; }
if [ ! -d "$source_dir/.git" ]; then
  [ ! -e "$source_dir" ] || { echo 'DSH path exists without .git; reconcile it first'; exit 1; }
  as_secretary git clone --branch "$DSH_BRANCH" --single-branch "$DSH_REPO" "$source_dir"
fi
[ -z "$(as_secretary git -C "$source_dir" status --porcelain --untracked-files=normal)" ] || {
  echo 'DSH has local changes; preserve and reconcile them before updating'; exit 1;
}
if [ "$(as_secretary git -C "$source_dir" rev-parse HEAD)" != "$DSH_COMMIT" ]; then
  as_secretary git -C "$source_dir" fetch origin "$DSH_COMMIT"
  as_secretary git -C "$source_dir" checkout --detach "$DSH_COMMIT"
fi
if [ "$(cat /home/secretary/.dsh-build-stamp 2>/dev/null || true)" != "$DSH_COMMIT" ] || [ ! -f "$source_dir/apps/cli/lib/bin.js" ]; then
  # Incus exposes the container memory limit via cgroup v2 on Debian 13.
  memory="$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)"
  if [[ "$memory" =~ ^[0-9]+$ ]] && [ "$memory" -lt 12884901888 ]; then
    echo 'DSH build needs >=12GiB memory; set secretary.memory=16GiB and apply first'; exit 1
  fi
  as_secretary bash -c 'cd "$1"; corepack prepare "$(node -p '\''require("./package.json").packageManager'\'')" --activate; pnpm install --frozen-lockfile; pnpm run build' bash "$source_dir"
  as_secretary bash -c 'printf "%s\n" "$1" > "$HOME/.dsh-build-stamp"' bash "$DSH_COMMIT"
fi
install -d -m 755 /usr/local/lib/dev-dsh/bin
install -m 755 "$SHARED/files/dsh-bwrap" /usr/local/lib/dev-dsh/bin/bwrap
install -m 755 "$DIR/files/secretary-dsh" /usr/local/bin/secretary-dsh
as_secretary /usr/local/bin/secretary-dsh --profile web --dump-config >/dev/null
# Same checkout-local plugin and native payload as the other dev containers.
profile=/home/secretary/.dsh/profiles/web/package.json
if ! grep -q '"@deepseek-ai/dsh-subagent-codex"' "$profile" 2>/dev/null; then
  as_secretary /usr/local/bin/secretary-dsh plugin --profile web add "link:$source_dir/packages/subagent/subagent-codex"
fi
as_secretary /opt/nanomuse/current/.venv/bin/python "$DIR/tooling/codex-config.py"
as_secretary python3 "$DIR/tooling/dsh-skills.py" /home/secretary/.nanomuse/skills /home/secretary/.agents/skills Codex
# The common seeder preserves existing blocks verbatim, including !!js and secrets.
as_secretary python3 "$SHARED/files/seed-web-settings" "$SHARED/files/web-defaults.yml" /home/secretary/.dsh/profiles/web/cordis.patch.yml
as_secretary python3 "$SHARED/files/seed-web-settings" "$DIR/files/dsh-secretary.yml" /home/secretary/.dsh/profiles/web/cordis.patch.yml
[ -e /home/secretary/.dsh/AGENTS.md ] || install -m 600 -o secretary -g secretary "$DIR/files/DSH_AGENTS.md" /home/secretary/.dsh/AGENTS.md
as_secretary python3 "$DIR/tooling/dsh-skills.py" /home/secretary/.nanomuse/skills /home/secretary/.dsh/skills
touch /home/secretary/.dsh/web.log
chown secretary:secretary /home/secretary/.dsh/web.log
chmod 600 /home/secretary/.dsh/web.log
install -m 644 "$DIR/files/secretary-dsh.service" /etc/systemd/system/dsh-web.service
# Do not relax sandbox isolation if the container cannot support it.
as_secretary /usr/local/lib/dev-dsh/bin/bwrap --ro-bind / / --dev /dev --proc /proc --unshare-user --unshare-pid --unshare-net -- true
systemctl daemon-reload
systemctl enable dsh-web.service
systemctl restart dsh-web.service
