#!/usr/bin/env bash
# NanoMuseを標準の秘書として導入し、旧試用文書を統合する。
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exit 1
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
/usr/bin/python3 "$DIR/tooling/check-idle.py"
source "$DIR/versions.env"
id secretary >/dev/null
[ -x /usr/local/bin/secretary ] || { echo '先に secretary/provision を実行してください' >&2; exit 1; }
apt-get update
apt-get install -y python3-venv curl ca-certificates
install -d -m 755 /opt/nanomuse
if [ "$(cat /opt/nanomuse/commit 2>/dev/null || true)" != "$NANOMUSE_COMMIT" ]; then
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  curl -fsSL "https://codeload.github.com/nano-muse/nanoMuse/tar.gz/$NANOMUSE_COMMIT" -o "$work/source.tar.gz"
  echo "$NANOMUSE_SOURCE_SHA256  $work/source.tar.gz" | sha256sum -c -
  install -d "/opt/nanomuse/$NANOMUSE_COMMIT"
  tar -xzf "$work/source.tar.gz" -C "/opt/nanomuse/$NANOMUSE_COMMIT" --strip-components=1
  python3 -m venv "/opt/nanomuse/$NANOMUSE_COMMIT/.venv"
  "/opt/nanomuse/$NANOMUSE_COMMIT/.venv/bin/pip" install "/opt/nanomuse/$NANOMUSE_COMMIT"
  ln -sfn "/opt/nanomuse/$NANOMUSE_COMMIT" /opt/nanomuse/current
  echo "$NANOMUSE_COMMIT" > /opt/nanomuse/commit
fi
install -d -m 700 -o secretary -g secretary /home/secretary/.nanomuse
if [ ! -e /home/secretary/.nanomuse/config.toml ]; then
  install -m 600 -o secretary -g secretary "$DIR/files/nanomuse.toml" /home/secretary/.nanomuse/config.toml
fi
was_active=0
systemctl is-active --quiet secretary-nanomuse.service && was_active=1
restore_service() {
  local status=$?
  if [ "$status" -ne 0 ] && [ "$was_active" -eq 1 ]; then
    systemctl daemon-reload
    systemctl start secretary-nanomuse.service || true
  fi
}
trap restore_service EXIT
systemctl stop secretary-nanomuse.service
install -m 644 "$DIR/files/migrate-nanomuse.py" /opt/secretary/
python3 /opt/secretary/migrate-nanomuse.py
install -m 644 "$DIR/files/nanomuse-mobile.py" /opt/secretary/
install -m 644 "$DIR/files/secretary-nanomuse.service" /etc/systemd/system/
install -m 755 "$DIR/backup" /opt/secretary/backup
bash "$DIR/tools-install" "$DIR/karakeep.bundle"
systemctl daemon-reload
systemctl enable secretary-nanomuse.service
systemctl restart secretary-nanomuse.service
echo 'NanoMuseを追加しました。Macで dev secretary を実行してください。'
