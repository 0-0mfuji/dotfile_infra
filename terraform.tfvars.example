# cp terraform.tfvars.example terraform.tfvars して編集する。
# terraform.tfvars 自体はGit管理しない (.gitignore済み)。

storage_pool = "dev"           # Incus上のstorage pool名
zfs_source   = "dev-tank/incus" # host/storage-init が作成したZFS dataset
dev_network  = "devbr0"        # Development Network用のbridge名

ssh_public_key = "ssh-ed25519 AAAA... you@macbook"

dev_instances = {
  lang = {
    cpu       = 4
    memory    = "4GiB"
    disk_size = "50GiB"
  }
  cpu = {
    cpu       = 8
    memory    = "8GiB"
    disk_size = "100GiB"
  }
  ml = {
    cpu       = 8
    memory    = "16GiB"
    disk_size = "200GiB" # Kaggleのデータセット・モデル用。GPUは dev-base 経由で全コンテナに渡る
  }
  os = {
    packages = ["qemu-system-x86", "nasm", "gdb", "make"]
    cpu       = 4
    memory    = "4GiB"
    disk_size = "50GiB"
  }
  fpga = {
    cpu       = 4
    memory    = "8GiB"
    disk_size = "80GiB"
  }
  robot = {
    image     = "images:ubuntu/22.04/cloud" # ROS想定
    cpu       = 4
    memory    = "8GiB"
    disk_size = "80GiB"
  }
  flutter = {
    cpu       = 4
    memory    = "8GiB"
    disk_size = "80GiB"
  }
  # --- 動画制作 (3つ1組。video が voice を呼ぶ。voice / blender は、必要になるまで作らなくてよい) ---
  video = {
    cpu       = 8
    memory    = "16GiB"        # Remotion(Chrome)の並列レンダリング用。1並列あたり1〜2GiB
    disk_size = "200GiB"
    ip        = "10.10.0.20"   # 他と重ならない値にする。~/.ssh/config.local の HostName と合わせる
    media     = "rw"           # 共有ボリューム /srv/media (host/steps/45-media.sh)
  }
  voice = {
    cpu       = 4
    memory    = "4GiB"
    disk_size = "30GiB"        # VOICEVOX ENGINE (展開後 数GB)
    gpu       = false          # CPU版を使い、VRAM(8GB共有)を whisper / Blender に残す
    media     = "rw"
    ip        = "10.10.0.21"   # video からの呼び出し先 (http://10.10.0.21:50021)。web_port は付けない (VOICEVOXには認証が無い)
  }
  # blender = {
  #   cpu       = 8
  #   memory    = "16GiB"
  #   disk_size = "100GiB"
  #   ip        = "10.10.0.22"
  #   media     = "rw"
  # }
}
