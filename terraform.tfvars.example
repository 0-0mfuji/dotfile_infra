# cp terraform.tfvars.example terraform.tfvars して編集する。
# terraform.tfvars 自体はGit管理しない (.gitignore済み)。

storage_pool = "dev"           # Incus上のstorage pool名
zfs_source   = "dev-tank/incus" # host/storage-init が作成したZFS dataset
dev_network  = "devbr0"        # Development Network用のbridge名

ssh_public_key = "ssh-ed25519 AAAA... you@macbook"

dev_instances = {
  lang = {
    cpu       = 4
    memory    = "4GiB"
    disk_size = "50GiB"
  }
  cpu = {
    cpu       = 8
    memory    = "8GiB"
    disk_size = "100GiB"
  }
  ml = {
    cpu       = 8
    memory    = "16GiB"
    disk_size = "200GiB" # Kaggleのデータセット・モデル用。GPUは dev-base 経由で全コンテナに渡る
  }
  os = {
    packages = ["qemu-system-x86", "nasm", "gdb", "make"]
    cpu       = 4
    memory    = "4GiB"
    disk_size = "50GiB"
  }
  fpga = {
    cpu       = 4
    memory    = "8GiB"
    disk_size = "80GiB"
  }
  robot = {
    image     = "images:ubuntu/22.04/cloud" # ROS想定
    cpu       = 4
    memory    = "8GiB"
    disk_size = "80GiB"
  }
  flutter = {
    cpu       = 4
    memory    = "8GiB"
    disk_size = "80GiB"
  }
  video = {
    cpu       = 8
    memory    = "16GiB"
    disk_size = "200GiB"
  }
}
